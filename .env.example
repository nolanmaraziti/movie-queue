# Copy this file to .env.local and paste your TMDB "API Read Access Token" after the = sign.
# Find it at https://www.themoviedb.org/settings/api
# .env.local is listed in .gitignore, so your real token never gets uploaded to GitHub.
TMDB_API_TOKEN=

# Database connection string (Postgres). On Vercel, the Neon integration adds this for you.
# For your computer, copy the DATABASE_URL value from Vercel's Storage tab.
DATABASE_URL=
